---
import type { CollectionEntry } from 'astro:content';
import { categories } from '../lib/content';
import TopicArt from './TopicArt.astro';
import { extractFirstImage } from '../lib/article-image';
interface Props { articles: CollectionEntry<'articles'>[]; }
const {articles}=Astro.props;
---
<div class="article-list">
{articles.length ? articles.map((entry)=>{const thumb=extractFirstImage(entry.body);return <article class="article-card im-card"><a class="article-cover" href={`/articles/${entry.id}/`} aria-label={entry.data.title}>{thumb?<img class="article-thumb" src={thumb} alt="" loading="lazy"/>:<TopicArt category={entry.data.category} prefix={`article-${entry.id}`}/>}</a><div class="article-copy"><p class="meta">{categories[entry.data.category]} · <time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toISOString().slice(0,10)}</time></p><h2><a href={`/articles/${entry.id}/`}>{entry.data.title}</a></h2><p>{entry.data.description}</p><a class="card-link" href={`/articles/${entry.id}/`}>기록 읽기 <span aria-hidden="true">↗</span></a></div></article>}) : <p class="empty">아직 공개한 기록이 없습니다. 환경과 검증 근거를 확인한 글부터 발행합니다.</p>}
</div>
