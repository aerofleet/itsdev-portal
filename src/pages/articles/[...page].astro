---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { publishedArticles } from '../../lib/content';
import { paginateRecords } from '../../lib/pagination';
import CategoryNav from '../../components/CategoryNav.astro';
import Pagination from '../../components/Pagination.astro';
import type { GetStaticPaths } from 'astro';
export const getStaticPaths=(async()=>paginateRecords(await publishedArticles(),'/articles/').map(page=>({params:{page:page.currentPage===1?undefined:String(page.currentPage)},props:{page}}))) satisfies GetStaticPaths;
const {page}=Astro.props;
---
<Base title={page.currentPage===1?'기록':`기록 · ${page.currentPage}페이지`}><header class="page-head library-head"><p class="hub-eyebrow">Engineering Fieldnotes</p><h1>판단의 과정을 읽습니다.</h1><p>설계의 이유, 운영의 조건, 검증의 근거를 주제별로 살펴보세요.</p></header><CategoryNav/><p class="result-count">공개 기록 {page.total}편</p><ArticleList articles={page.data}/><Pagination page={page}/></Base>
