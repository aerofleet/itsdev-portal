---
import Base from '../layouts/Base.astro';

const email = "itsdevkr@gmail.com";

const contactReasons = [
  {
    title: "기록 정정", tag: "Feedback",
    desc: "기술 아티클의 오탈자, 잘못된 정보, 누락된 레퍼런스를 제보해주세요.",
    subject: "[ITSDEV] 기술 기록 정정 요청",
    body: "1. 아티클 제목 또는 링크:\n\n2. 수정/정정이 필요한 내용:\n\n3. 관련 참고 자료(선택):",
  },
  {
    title: "기술 질문", tag: "Q&A",
    desc: "다룬 주제나 아키텍처에 대한 추가 논의 및 질문을 환영합니다.",
    subject: "[ITSDEV] 기술 아티클 질문",
    body: "1. 관련 아티클 제목 또는 주제:\n\n2. 질문 또는 논의하고 싶은 내용:",
  },
  {
    title: "협업 제안", tag: "Collab",
    desc: "프로젝트 협업, 기술 교류, 기고 등 다양한 제안을 기다립니다.",
    subject: "[ITSDEV] 협업 및 교류 제안",
    body: "1. 소속 / 닉네임:\n\n2. 제안 배경 및 내용:\n\n3. 연락처 또는 회신 링크:",
  },
];

function mailto(subject: string, body: string) {
  const p = new URLSearchParams({ subject, body });
  return `mailto:${email}?${p.toString().replace(/\+/g, '%20')}`;
}
---
<Base title="문의" description="ITSDEV에 대한 문의, 기록 정정 요청, 협업 제안은 이메일로 보내주세요.">
<div class="contact-container">
 <header class="contact-header">
  <div class="status-badge"><span class="status-dot"></span><span>보통 1–2 영업일 내 회신</span></div>
  <h1>Contact &amp; Feedback</h1>
  <p>문의 목적에 맞는 카드를 선택하면 템플릿이 자동으로 채워집니다.</p>
 </header>
 <section class="email-bar">
  <div class="email-info">
   <span class="label">Direct Contact</span>
   <span class="email-address">{email}</span>
  </div>
  <button id="copy-btn" class="btn btn-copy" data-email={email}>
   <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
   <span id="copy-text">이메일 복사</span>
  </button>
 </section>
 <section class="inquiry-types">
  <h2 class="section-title">문의 유형 선택</h2>
  <div class="inquiry-grid">
   {contactReasons.map((item) => (
    <a href={mailto(item.subject, item.body)} class="inquiry-card" title={`${item.title} 템플릿으로 메일 작성`}>
     <span class="card-top">
      <span class="inquiry-tag">{item.tag}</span>
      <span class="action-hint">템플릿 열기 <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></span>
     </span>
     <h3>{item.title}</h3>
     <p>{item.desc}</p>
    </a>
   ))}
  </div>
 </section>
</div>
</Base>

<script>
const copyBtn = document.getElementById('copy-btn');
const copyText = document.getElementById('copy-text');
copyBtn?.addEventListener('click', async () => {
 const email = copyBtn.getAttribute('data-email');
 if (!email) return;
 try {
  await navigator.clipboard.writeText(email);
  if (copyText) copyText.textContent = '복사 완료!';
  copyBtn.classList.add('copied');
  setTimeout(() => { if (copyText) copyText.textContent = '이메일 복사'; copyBtn.classList.remove('copied'); }, 2000);
 } catch { window.location.href = `mailto:${email}`; }
});
</script>

<style>
.contact-container{max-width:720px;margin:0 auto;padding:3rem var(--gutter)}
.contact-header{margin-bottom:2rem}
.status-badge{display:inline-flex;align-items:center;gap:.5rem;font-size:.8125rem;color:var(--muted);background:var(--surface);padding:.25rem .75rem;border-radius:9999px;margin-bottom:1rem;border:1px solid var(--rule)}
.status-dot{width:7px;height:7px;background:#10b981;border-radius:50%;box-shadow:0 0 0 2px rgba(16,185,129,.2);flex-shrink:0}
.contact-header h1{font-size:clamp(2rem,4vw,2.5rem);font-weight:800;letter-spacing:-.04em;margin:0 0 .5rem}
.contact-header p{color:var(--muted);font-size:1.05rem;line-height:1.6;margin:0}
.email-bar{display:flex;align-items:center;justify-content:space-between;background:var(--surface);border:1px solid var(--rule);border-radius:12px;padding:1rem 1.25rem;margin-bottom:2.5rem}
.email-info{display:flex;align-items:center;gap:.75rem}
.email-info .label{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.email-address{font-size:.95rem;font-weight:600;color:var(--accent)}
.btn-copy{display:inline-flex;align-items:center;gap:.375rem;background:transparent;border:1px solid var(--rule);padding:.45rem .85rem;border-radius:8px;font-size:.825rem;font-weight:600;cursor:pointer;color:var(--ink);transition:background .15s,border-color .15s;min-height:44px}
.btn-copy:hover{background:var(--tile)}
.btn-copy.copied{border-color:var(--accent);color:var(--accent)}
.copy-icon{width:14px;height:14px;flex-shrink:0}
.section-title{font-size:1.1rem;font-weight:650;margin-bottom:1rem;color:var(--muted)}
.inquiry-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
.inquiry-card{background:var(--surface);border:1px solid var(--rule);border-radius:14px;padding:1.25rem;display:flex;flex-direction:column;gap:.5rem;text-decoration:none;color:var(--ink);transition:transform .2s,border-color .2s,box-shadow .2s;cursor:pointer}
.inquiry-card:hover{transform:translateY(-3px);border-color:var(--accent);box-shadow:0 8px 20px rgba(0,0,0,.08)}
.card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:.25rem}
.inquiry-tag{font-size:.7rem;font-weight:700;letter-spacing:.06em;background:var(--tile);border:1px solid var(--rule);padding:.15rem .5rem;border-radius:6px;color:var(--muted)}
.action-hint{display:inline-flex;align-items:center;gap:.2rem;font-size:.75rem;font-weight:500;color:var(--muted);transition:color .15s}
.arrow{width:14px;height:14px;transition:transform .2s}
.inquiry-card:hover .action-hint{color:var(--accent)}
.inquiry-card:hover .arrow{transform:translate(2px,-2px)}
.inquiry-card h3{margin:0;font-size:1.05rem;font-weight:650}
.inquiry-card p{margin:0;font-size:.825rem;line-height:1.55;color:var(--muted)}
@media(max-width:640px){.contact-container{padding:2rem var(--gutter)}.inquiry-grid{grid-template-columns:1fr}.email-bar{flex-direction:column;gap:.75rem;align-items:stretch}.email-info{justify-content:space-between}.btn-copy{justify-content:center}.contact-header h1{font-size:1.75rem}}
@media(prefers-reduced-motion:reduce){.inquiry-card{transition:none}.inquiry-card:hover{transform:none}}
:root[data-motion=off] .inquiry-card{transition:none;transform:none}
</style>
