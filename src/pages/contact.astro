---
import Base from '../layouts/Base.astro';

const email = "itsdevkr@gmail.com";

const contactReasons = [
  { title: "기록 정정", desc: "기술 아티클의 오탈자, 잘못된 정보, 누락된 레퍼런스를 제보해주세요.", tag: "Feedback" },
  { title: "기술 질문", desc: "다룬 주제나 아키텍처에 대한 추가 논의 및 질문을 환영합니다.", tag: "Q&A" },
  { title: "협업 제안", desc: "프로젝트 협업, 기술 교류, 기고 등 다양한 제안을 기다립니다.", tag: "Collab" },
];
---
<Base title="문의" description="ITSDEV에 대한 문의, 기록 정정 요청, 협업 제안은 이메일로 보내주세요.">
<div class="contact-container">
 <header class="contact-header">
  <div class="status-badge"><span class="status-dot"></span><span>보통 1–2 영업일 내 회신</span></div>
  <h1>Contact &amp; Feedback</h1>
  <p>기록 정정, 기술 질문, 협업 제안 등 어떤 이야기든 환영합니다.</p>
 </header>
 <section class="email-card">
  <div class="email-info">
   <span class="label">Direct Email</span>
   <a href={`mailto:${email}`} class="email-address">{email}</a>
  </div>
  <div class="action-buttons">
   <button id="copy-btn" class="btn btn-secondary" data-email={email}><span id="copy-text">주소 복사</span></button>
   <a href={`mailto:${email}`} class="btn btn-primary">메일 앱 열기</a>
  </div>
 </section>
 <section class="inquiry-types">
  <h2 class="section-title">주요 문의 유형</h2>
  <div class="inquiry-grid">
   {contactReasons.map((item) => (
    <div class="inquiry-card">
     <span class="inquiry-tag">{item.tag}</span>
     <h3>{item.title}</h3>
     <p>{item.desc}</p>
    </div>
   ))}
  </div>
 </section>
</div>
</Base>

<script>
const copyBtn = document.getElementById('copy-btn');
const copyText = document.getElementById('copy-text');
copyBtn?.addEventListener('click', async () => {
 const email = copyBtn.getAttribute('data-email');
 if (!email) return;
 try {
  await navigator.clipboard.writeText(email);
  if (copyText) copyText.textContent = '복사 완료!';
  copyBtn.classList.add('copied');
  setTimeout(() => { if (copyText) copyText.textContent = '주소 복사'; copyBtn.classList.remove('copied'); }, 2000);
 } catch { window.location.href = `mailto:${email}`; }
});
</script>

<style>
.contact-container{max-width:680px;margin:0 auto;padding:3rem var(--gutter)}
.contact-header{margin-bottom:2.5rem}
.status-badge{display:inline-flex;align-items:center;gap:.5rem;font-size:.8125rem;color:var(--muted);background:var(--surface);padding:.25rem .75rem;border-radius:9999px;margin-bottom:1rem;border:1px solid var(--rule)}
.status-dot{width:7px;height:7px;background:#10b981;border-radius:50%;box-shadow:0 0 0 2px rgba(16,185,129,.2);flex-shrink:0}
.contact-header h1{font-size:clamp(2rem,4vw,2.5rem);font-weight:800;letter-spacing:-.04em;margin:0 0 .5rem}
.contact-header p{color:var(--muted);font-size:1.05rem;line-height:1.6;margin:0}
.email-card{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1.25rem;background:var(--surface);border:1px solid var(--rule);border-radius:16px;padding:1.5rem;margin-bottom:3rem}
.email-info{display:flex;flex-direction:column;gap:.25rem}
.email-info .label{font-size:.75rem;text-transform:uppercase;font-weight:700;letter-spacing:.08em;color:var(--muted)}
.email-address{font-size:1.25rem;font-weight:600;color:var(--accent);text-decoration:none;font-variant-numeric:tabular-nums}
.email-address:hover{text-decoration:underline}
.action-buttons{display:flex;gap:.5rem}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:.625rem 1.125rem;border-radius:10px;font-size:.875rem;font-weight:600;cursor:pointer;text-decoration:none;transition:background .15s,border-color .15s;min-height:44px}
.btn-primary{background:var(--accent);color:var(--on-accent);border:1px solid transparent}
.btn-primary:hover{opacity:.88}
.btn-secondary{background:transparent;color:var(--ink);border:1px solid var(--rule)}
.btn-secondary:hover{background:var(--tile)}
.btn-secondary.copied{border-color:var(--accent);color:var(--accent)}
.section-title{font-size:1.125rem;font-weight:650;margin-bottom:1rem;color:var(--muted)}
.inquiry-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
.inquiry-card{background:var(--tile);border:1px solid var(--rule);border-radius:14px;padding:1.25rem;display:flex;flex-direction:column;gap:.5rem;transition:border-color .15s}
.inquiry-card:hover{border-color:var(--accent)}
.inquiry-tag{align-self:flex-start;font-size:.7rem;font-weight:700;letter-spacing:.06em;background:var(--surface);border:1px solid var(--rule);padding:.15rem .5rem;border-radius:6px;color:var(--muted)}
.inquiry-card h3{margin:0;font-size:.975rem;font-weight:650}
.inquiry-card p{margin:0;font-size:.825rem;line-height:1.55;color:var(--muted)}
@media(max-width:640px){.contact-container{padding:2rem var(--gutter)}.inquiry-grid{grid-template-columns:1fr}.email-card{flex-direction:column;align-items:stretch}.action-buttons{flex-direction:column}.contact-header h1{font-size:1.75rem}}
</style>
