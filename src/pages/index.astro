---
import Base from '../layouts/Base.astro';
import TopicArt from '../components/TopicArt.astro';
import TopicGallery from '../components/TopicGallery.astro';
import ArticleList from '../components/ArticleList.astro';
import { publishedArticles, categories } from '../lib/content';
const articles=await publishedArticles();
const featured=articles.find(a=>a.data.featured);
const principles=[
 ['무엇이 문제였는지부터 기록합니다.','증상과 적용 환경을 먼저 기록합니다. 무엇이 실패했는지, 어디까지 확인했는지 구분합니다.'],
 ['선택의 이유와 다른 대안을 함께 남깁니다.','채택한 대안과 검토한 대안을 비교합니다. 자원과 운영 비용, 적용할 수 없는 조건도 판단에 포함합니다.'],
 ['검증한 만큼만 이야기합니다.','방법·관측값·조건·한계를 함께 기록합니다. 실행하지 않은 검증은 예정으로 남기고, 측정하지 않은 성과를 만들지 않습니다.'],
 ['바뀐 판단은 개정 이력으로 남깁니다.','조건이 바뀌면 판단을 다시 합니다. 이전 문장을 최신 근거로 고치고, 변경 이유와 확인 시점을 이력으로 남깁니다.'],
];
---
<Base>
 <section class="hub-intro" aria-labelledby="hub-title"><p class="hub-eyebrow">Engineering Fieldnotes</p><h1 id="hub-title">만들고, 운영하고.<br/><span>근거를 남깁니다.</span></h1><p class="hub-description">직접 만든 서비스에서 출발한 기술 기록.<br/>선택의 이유부터 검증의 한계, 그리고 다음 개정까지.</p><div class="hub-topics"><span>설계의 이유</span><span>운영의 조건</span><span>검증의 근거</span></div></section>
 <section class="hub-feature" aria-labelledby="feature-title"><div class="hub-feature-art"><TopicArt category={featured?.data.category||'log'} prefix="featured"/><span class="feature-label">{featured?'FEATURED FIELDNOTE':'기록의 원칙'}</span></div><div class="hub-feature-copy"><p class="hub-eyebrow">{featured?categories[featured.data.category]:'From decisions to evidence'}</p><h2 id="feature-title">{featured?featured.data.title:<>좋은 결론보다,<br/>확인할 수 있는 과정이 남도록.</>}</h2><p>{featured?featured.data.description:'서비스를 만들면서 내린 선택은 운영 속에서 달라집니다. 무엇을 선택했고, 어디까지 확인했는지. 다음 판단에 도움이 되는 기록을 남깁니다.'}</p><div class="feature-actions"><span class="editor-signature">ITSDEV</span><a class="primary" href={featured?`/articles/${featured.id}/`:'/about/'}>{featured?'기록 읽기':'기록 원칙 읽기'}</a></div></div></section>
 <section class="hub-library" id="records" aria-labelledby="records-title"><div class="section-head"><div><p class="hub-eyebrow">Explore the fieldnotes</p><h2 id="records-title">{articles.length?'최근 기록':'어떤 문제를 보고 계신가요?'}</h2></div><a class="text-link" href="/articles/">전체 기록</a></div><nav class="category-links" aria-label="기록 분류"><a href="/articles/">전체</a>{Object.entries(categories).map(([id,label])=><a href={`/articles/category/${id}/`}>{label}</a>)}</nav>{articles.length?<ArticleList articles={articles.slice(0,6)}/>:<><TopicGallery/><p class="empty">아직 공개한 기록이 없습니다. 위 카드는 기록을 모아갈 주제 안내입니다.</p></>}</section>
 <section class="hub-services" aria-label="서비스와 구독"><article class="hub-service"><p class="hub-eyebrow">Built & operated</p><h2>기록의 출발점은<br/>직접 만든 서비스입니다.</h2><p>DJC의 채용 공고 탐색부터 WithBuddy의 온보딩까지. 서비스에서 만난 문제와 판단을 소개합니다.</p><div class="service-pair"><a href="/services/djc/">DJC 소개 ↗</a><a href="/services/withbuddy/">WithBuddy 소개 ↗</a></div></article><article class="hub-service"><p class="hub-eyebrow">Stay curious</p><h2>다음 기록도,<br/>읽던 곳에서 이어서.</h2><p>새 글은 RSS로 받아볼 수 있습니다. 공개한 기록만 피드에 담고, 수정한 내용은 글의 개정 이력에 남깁니다.</p><a class="primary" href="/rss.xml">RSS 피드 열기</a></article></section>
 <section class="hub-method" aria-labelledby="method-title"><header><p class="hub-eyebrow">How we write</p><h2 id="method-title">기록을 읽는 네 가지 기준</h2></header>{principles.map(([title,description])=><details><summary>{title}</summary><p>{description}</p></details>)}</section>
</Base>
