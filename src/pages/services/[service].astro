---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import {publishedArticles} from '../../lib/content';
export function getStaticPaths(){return [{params:{service:'djc'},props:{name:'DJC',description:'흩어진 개발 직군 공고의 출처와 중복·만료 정보를 정리해, 탐색과 원문 이동을 돕습니다.'}},{params:{service:'withbuddy'},props:{name:'WithBuddy',description:'온보딩 과정의 질문과 문서 근거를 연결하는 서비스입니다.'}}]}
const {name,description}=Astro.props;
const related=(await publishedArticles()).filter(e=>e.data.service===Astro.params.service);
---
<Base title={name} description={description}><header class="page-head"><a href="/services/">서비스 목록</a><h1>{name}</h1><p>{description}</p></header><div class="prose"><h2>서비스와 기록</h2><p>구현 과정에서 내린 판단과 검증 근거는 관련 기록으로 소개합니다.</p>{Astro.params.service==='djc'&&<p><a href="https://djc.itsdev.kr" target="_blank" rel="noopener noreferrer">DJC 이용하기 · djc.itsdev.kr ↗</a></p>}</div><section><h2>관련 기록</h2><ArticleList articles={related}/></section></Base>
