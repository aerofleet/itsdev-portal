{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itsdev-portal",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "route": {
    "pattern": "itsdev.kr/*",
    "zone_name": "itsdev.kr"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
